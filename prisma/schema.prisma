generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model estudios {
  id           Int       @id @default(autoincrement())
  prenome      String    @db.VarChar(100)
  pais_origem  String?   @default("Japão") @db.VarChar(60)
  ano_fundacao Int?
  animes       animes[]
}

model animes {
  id              Int               @id @default(autoincrement())
  titulo          String            @db.VarChar(150)
  genero          String?           @db.VarChar(80)
  total_episodios Int?
  estudio_id      Int
  estudios        estudios          @relation(fields: [estudio_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_estudio")
  acompanhamentos acompanhamentos[]
}

model acompanhamentos {
  id                   Int      @id @default(autoincrement())
  status               String   @db.VarChar(50)
  episodios_assistidos Int?     @default(0)
  nota                 Decimal? @db.Decimal(3, 1)
  anime_id             Int
  animes               animes   @relation(fields: [anime_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_anime")
}